<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve index.html as default
  DirectoryIndex index.html

  # Direct access for _next static assets - DO NOT REWRITE
  RewriteCond %{REQUEST_URI} ^/_next/ [NC]
  RewriteRule ^ - [L]

  # Redirect folder requests without trailing slash to trailing slash (prevent 403)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ $1/ [L,R=301]

  # Serve index.html if the requested directory exists
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Serve static file if it exists directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Fallback to custom 404 page for missing routes
  ErrorDocument 404 /404.html
</IfModule>
